{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "matrixHeatmap",
  "position": {
    "x": 20,
    "y": 96,
    "z": 3,
    "width": 1240,
    "height": 330,
    "tabOrder": 3
  },
  "visual": {
    "visualType": "pivotTable",
    "query": {
      "queryState": {
        "Rows": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "weekday_name"
                }
              },
              "queryRef": "dim_date.weekday_name",
              "nativeQueryRef": "weekday_name"
            }
          ]
        },
        "Columns": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_games"
                    }
                  },
                  "Property": "hour"
                }
              },
              "queryRef": "fact_games.hour",
              "nativeQueryRef": "hour"
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Mesures"
                    }
                  },
                  "Property": "Parties par Jour"
                }
              },
              "queryRef": "_Mesures.Parties par Jour",
              "nativeQueryRef": "Parties par Jour"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Carte de chaleur : parties par jour et heure (UTC)'"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Nombre moyen de parties par jour calendaire ; couleur de fond = intensité'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
